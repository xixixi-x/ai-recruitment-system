# ===== Web Gin Gateway =====
WEB_PORT=8080
LOGIC_GRPC_ADDR=127.0.0.1:9090
JWT_SECRET=change-this-secret
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174

# ===== Logic gRPC Service =====
LOGIC_GRPC_PORT=9090
MYSQL_DSN=root:123456@tcp(127.0.0.1:3306)/ai_recruitment?charset=utf8mb4&parseTime=True&loc=Local

# ===== Private OSS: required for formal submission/demo =====
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-private-bucket-name
OSS_SIGN_EXPIRE_SECONDS=600

# ===== AI via Eino OpenAI-compatible ChatModel =====
AI_API_KEY=your-deepseek-or-compatible-api-key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
